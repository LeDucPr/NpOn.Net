{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "IsStartAsync": false,
  "HostPort": 40001,
  "HostDomain": "http://localhost",
  "ConnectionString": "Host=localhost;Port=5432;Database=np_on_db;Username=postgres;Password=password",
  "CORS": "localhost:5000, *",
